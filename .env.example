# ============================================================
# REQUIRED FOR VERCEL DEPLOYMENT
# ============================================================

# Supabase Configuration (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# WhatsApp token encryption (64 hex characters = 32 bytes, AES-256-GCM)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_encryption_key

# Meta App & WhatsApp Embedded Signup (Meta App Dashboard)
NEXT_PUBLIC_META_APP_ID=your_meta_app_id
META_APP_ID=your_meta_app_id
NEXT_PUBLIC_META_CONFIG_ID=your_meta_config_id
META_APP_SECRET=your_meta_app_secret

# Webhook Verification Secret for WhatsApp Webhooks
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Public Application URL (Vercel domain or custom domain)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ============================================================
# AI Providers (At least one required for AI Agents)
# ============================================================
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key

# AgentRouter (Unified multi-model gateway: https://agentrouter.org)
# Access Claude, GPT-4o, DeepSeek V3/R1 via a single OpenAI-compatible endpoint
AGENTROUTER_API_KEY=your_agentrouter_api_key
AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1
# Optional model overrides for AgentRouter tiers
# AGENTROUTER_MODEL_FAST=gpt-4o-mini
# AGENTROUTER_MODEL_BALANCED=gpt-4o
# AGENTROUTER_MODEL_ADVANCED=claude-3-5-sonnet
